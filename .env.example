# Copier en .env puis adapter : cp .env.example .env

# Port publié sur l'hôte pour l'interface web (nginx)
WEB_PORT=8080

# Origines autorisées pour Socket.IO (polling ET WebSocket), séparées par des virgules.
# "*" = toutes. En production derrière un domaine : https://komintern.example.com
ALLOWED_ORIGINS=*

# Limitation de débit par socket (au-delà, les actions sont ignorées et le client prévenu)
SOCKET_RATE_LIMIT_MAX_EVENTS=80
SOCKET_RATE_LIMIT_WINDOW_MS=10000

# Déconnexion plus longue que ce délai : au salon le joueur libère sa place,
# en partie sa faction perd par abandon.
AFK_TIMEOUT_MS=60000
# Room sans aucun joueur connecté : supprimée (avec son moteur Python) après ce délai.
EMPTY_ROOM_GRACE_MS=120000
# Nombre maximum de rooms simultanées (une partie = un process Python).
MAX_ROOMS=200
# Délai max d'une commande moteur avant de considérer le moteur comme figé.
ENGINE_TIMEOUT_MS=5000
# debug | info | warn | error | silent
LOG_LEVEL=info

# (Optionnel, figé au build du client) URL du serveur Socket.IO.
# Laisser vide : le client utilise la même origine, nginx relaie /socket.io/.
VITE_SERVER_URL=

# Tunnel Cloudflare (optionnel) : expose le site en HTTPS sans ouvrir de port sur la box.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
