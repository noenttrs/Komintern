# Copier en .env puis adapter : cp .env.example .env

# Port publié sur l'hôte pour l'interface web (nginx)
WEB_PORT=8080

# Origines autorisées pour Socket.IO (polling ET WebSocket), séparées par des virgules.
# "*" = toutes. En production derrière un domaine : https://komintern.example.com
ALLOWED_ORIGINS=*

# Limitation de débit par socket (au-delà, les actions sont ignorées et le client prévenu)
SOCKET_RATE_LIMIT_MAX_EVENTS=80
SOCKET_RATE_LIMIT_WINDOW_MS=10000

# Déconnexion plus longue que ce délai : au salon le joueur libère sa place,
# en partie sa faction perd par abandon.
AFK_TIMEOUT_MS=60000
# Room sans aucun joueur connecté : supprimée (avec son moteur Python) après ce délai.
EMPTY_ROOM_GRACE_MS=120000
# Nombre maximum de rooms simultanées (parties réparties sur ENGINE_WORKERS process Python).
MAX_ROOMS=1000
# Délai max d'une commande moteur avant de considérer le moteur comme figé.
ENGINE_TIMEOUT_MS=5000
# Process Python partagés entre toutes les parties (≈ 15 Mo chacun ; un crash n'arrête que ses parties).
ENGINE_WORKERS=4
# debug | info | warn | error | silent
LOG_LEVEL=info

# (Optionnel, figé au build du client) URL du serveur Socket.IO.
# Laisser vide : le client utilise la même origine, nginx relaie /socket.io/.
VITE_SERVER_URL=

# Tunnel Cloudflare (optionnel) : expose le site en HTTPS sans ouvrir de port sur la box.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- comptes et bases de données
# Mots de passe des bases (réseau Docker interne uniquement). Générer : openssl rand -hex 24
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_LOG_PASSWORD=
REDIS_PASSWORD=

# URL publique du site (cookies Secure, liens des emails, retour de Google)
PUBLIC_URL=https://fascismwontget.me

# Emails via Resend (https://resend.com) — vide : les codes sont écrits dans les logs du serveur
RESEND_API_KEY=
EMAIL_FROM="Nazi Communiste <noreply@fascismwontget.me>"

# Connexion Google (https://console.cloud.google.com/apis/credentials) — vide : bouton masqué
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Notifications Web Push — générer avec : cd server && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mentions légales (affichées sur /mentions-legales)
LEGAL_EDITOR_NAME=
LEGAL_CONTACT_EMAIL=

# Lien de don (Ko-fi) affiché sur /soutenir — vide : « les dons ouvrent bientôt »
DONATION_URL=

# Anonymisation des logs de parties au bout de N jours (défaut 365)
# LOG_ANONYMIZE_AFTER_DAYS=365
# Diffusions Socket.IO partagées via Redis (uniquement le jour où il y aura plusieurs instances)
# SOCKET_REDIS_ADAPTER=false

# Rooms des tests automatiques : un code « PREFIXE-xxxx » n'est pas enregistré (ni journal ni stats).
# 12 à 16 caractères A-Z/0-9, à garder secret (sinon des joueurs pourraient échapper aux journaux).
# Générer : tr -dc A-Z0-9 </dev/urandom | head -c 14 ; les tests e2e le lisent dans E2E_ROOM_PREFIX.
TEST_ROOM_PREFIX=
