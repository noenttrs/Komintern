    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=24"
  }
}
